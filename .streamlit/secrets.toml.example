# Streamlit Cloud Secrets Template
# Copy this to secrets.toml in Streamlit Cloud dashboard

# Database - Use cloud mode for Streamlit Cloud
DATABASE_MODE = "cloud"
SUPABASE_DB_URL = "postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# OpenAI - Required for AI scoring and prose generation
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# RapidAPI - For LinkedIn profile enrichment
RAPIDAPI_KEY = "your-rapidapi-key"

# Hunter.io - For email finding (optional)
HUNTER_API_KEY = "your-hunter-key"

# Gmail OAuth (optional - for sending emails)
# GMAIL_CLIENT_ID = ""
# GMAIL_CLIENT_SECRET = ""
