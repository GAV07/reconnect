# Reconnect Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================

# Local SQLite database path
DATABASE_PATH=data/reconnect.db

# Database mode: "local" (SQLite) or "cloud" (Supabase PostgreSQL)
DATABASE_MODE=local

# Supabase Cloud Database (required when DATABASE_MODE=cloud)
# Get this from: Supabase Dashboard > Settings > Database > Connection string (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=

# =============================================================================
# AI / LLM
# =============================================================================

# OpenAI - Required for AI-generated outreach and scoring
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# ENRICHMENT APIs
# =============================================================================

# RapidAPI - For LinkedIn profile enrichment
# Get your API key at https://rapidapi.com/freshdata-freshdata-default/api/fresh-linkedin-profile-data
RAPIDAPI_KEY=

# Apify - For LinkedIn activity scraping (deprecated, use RapidAPI instead)
# APIFY_API_KEY=
# APIFY_ACTOR_ID=2SyF0bVxmgGr8IVCZ

# Hunter.io - For email finding and enrichment
# Get your API key at https://hunter.io/api
HUNTER_API_KEY=

# =============================================================================
# GMAIL INTEGRATION (optional)
# =============================================================================

# Gmail OAuth2 credentials for sending emails
# Create at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# =============================================================================
# TELEGRAM NOTIFICATIONS (optional)
# =============================================================================

# Telegram bot for pipeline digest notifications
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id in the response JSON
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# LINKEDIN IMPORT
# =============================================================================

# Where to look for LinkedIn exports (for auto-import)
LINKEDIN_DATA_FOLDER=~/Downloads

# Glob pattern for LinkedIn export files/folders
LINKEDIN_EXPORT_PATTERN=LinkedIn Data Export*

# =============================================================================
# APP SETTINGS
# =============================================================================

# Minimum score (0-100) to generate outreach drafts — saves LLM tokens
# Contacts below this threshold are skipped during queue generation
QUEUE_MIN_SCORE=60

DEBUG=false
CACHE_TTL_DAYS=7
